---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Starfield from "../components/Starfield.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Donovan Thach builds AI for healthcare and assistive tech, backed by systems programming.",
} = Astro.props;
---

<html lang="en" class="scheme-dark motion-safe:data-loaded:scroll-smooth">
  <head>
    <Font cssVariable="--font-inter" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-space-grotesk" />
    <Font cssVariable="--font-jetbrains-mono" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05101c" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
      addEventListener("load", () => (document.documentElement.dataset.loaded = ""));
    </script>
  </head>
  <body class="min-h-screen bg-space-950 text-starlight antialiased">
    <a
      href="#main"
      class="sr-only rounded-lg bg-comet text-sm font-semibold text-space-950 focus:not-sr-only focus:fixed focus:top-4 focus: left-4 focus:z-50 focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Starfield />
    <Header />
    <main class="mx-auto max-w-3xl px-6 py-16">
      <slot />
    </main> 
  </body>
</html>
