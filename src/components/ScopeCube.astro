---
import type { Stage } from "../lib/stages";
import { buildCube, makeRandom, readFaces, turn } from "../lib/cube";

interface Props {
  size: number;
  px?: number;
  stage?: Stage;
  seed?: string;
  view?: "above" | "below";
  moves?: string;
}

const { size, px = 28, stage = "done", seed = "cube", view = "above", moves = " " } = Astro.props;

const cube = buildCube(size, stage, makeRandom(seed));
turn(cube, moves);
const faces = readFaces(cube);
---

<span class="scene" style={`--px: ${px}px; --n: ${size}`} aria-hidden="true">
  <span class={`cube ${view}`}>
    {
      faces.map((face) => (
        <span class={`face ${face.name}`}>
          {face.stickers.map((color) => (
            <span class="sticker" style={`background-color: ${color}`} />
          ))}
        </span>
      ))
    }
  </span>
</span>

<style>
  .scene {
    position: relative;
    display: inline-block;
    width: calc(var(--px) * 1.7);
    height: calc(var(--px) * 1.7);
    flex-shrink: 0;
    pointer-events: none;
  }

  .cube {
    --cube: calc(var(--px) * 4);
    --tilt: -35deg;
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    transform: translate(-50%, -50%) scale(0.25) rotateX(var(--tilt)) rotateY(-45deg);
  }

  .below {
    --tilt: 35deg;
  }

  .face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: 4px;
    padding: 4px;
    border-radius: 12px;
    background: var(--color-space-950);
  }

  .top {
    transform: rotateX(90deg) translateZ(calc(var(--cube) / 2));
  }

  .front {
    transform: translateZ(calc(var(--cube) / 2));
  }

  .right {
    transform: rotateY(90deg) translateZ(calc(var(--cube) / 2));
  }

  .back {
    transform: rotateY(180deg) translateZ(calc(var(--cube) / 2));
  }

  .left {
    transform: rotateY(-90deg) translateZ(calc(var(--cube) / 2));
  }

  .bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--cube) / 2));
  }

  .sticker {
    border-radius: 4px;
  }
</style>
