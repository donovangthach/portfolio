---
import type { Stage } from "../lib/stages";
import { buildCube, faceNames, makeRandom, place, turn } from "../lib/cube";

interface Props {
  size: number;
  px?: number;
  stage?: Stage;
  seed?: string;
  view?: "above" | "below";
  moves?: string;
}

const { size, px = 28, stage = "done", seed = "cube", view = "above", moves = "" } = Astro.props;

const cube = buildCube(size, stage, makeRandom(seed));
turn(cube, moves);
const tiles = cube.stickers.map((sticker) => ({ color: sticker.color, ...place(sticker, size) }));
---

<span
  class="scene"
  style={`--px: ${px}px; --n: ${size}`}
  data-size={size}
  data-stage={moves ? undefined : stage}
  data-seed={seed}
  aria-hidden="true"
>
  <span class={`cube ${view}`}>
    {faceNames.map((name) => <span class={`core ${name}`} />)}
    {
      tiles.map((tile) => (
        <span class="tile" data-face={tile.face} data-corner={tile.corner} style={`transform: ${tile.transform}`}>
          <span class="sticker" style={`background-color: ${tile.color}`} />
        </span>
      ))
    }
  </span>
</span>

<style>
  .scene {
    position: relative;
    display: inline-block;
    width: calc(var(--px) * 1.7);
    height: calc(var(--px) * 1.7);
    flex-shrink: 0;
    pointer-events: none;
  }

  .cube {
    --cube: calc(var(--px) * 4);
    --cell: calc(var(--cube) / var(--n));
    --inset: calc(var(--cell) * 0.15);
    --plastic: #111214;
    --tilt: -35deg;
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    transform: translate(-50%, -50%) scale(0.25) rotateX(var(--tilt)) rotateY(-45deg);
  }

  .below {
    --tilt: 35deg;
  }

  .tile {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--cell);
    height: var(--cell);
    margin: calc(var(--cell) / -2);
    padding: calc(var(--cell) * 0.04);
    background: var(--plastic);
    backface-visibility: hidden;
  }

  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(0 0 0 / var(--shade));
  }

  .sticker {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: calc(var(--cell) * 0.2);
  }

  .tile[data-face="top"] {
    --shade: 0;
  }

  .tile[data-face="front"],
  .tile[data-face="left"] {
    --shade: 0.06;
  }

  .tile[data-face="right"],
  .tile[data-face="back"] {
    --shade: 0.18;
  }

  .tile[data-face="bottom"] {
    --shade: 0.1;
  }

  .tile[data-corner="top-left"] {
    border-top-left-radius: calc(var(--cell) * 0.4);
  }

  .tile[data-corner="top-right"] {
    border-top-right-radius: calc(var(--cell) * 0.4);
  }

  .tile[data-corner="bottom-left"] {
    border-bottom-left-radius: calc(var(--cell) * 0.4);
  }

  .tile[data-corner="bottom-right"] {
    border-bottom-right-radius: calc(var(--cell) * 0.4);
  }

  .turning .core {
    visibility: hidden;
  }

  .cube :global(.cap) {
    position: absolute;
    inset: var(--inset);
    background: var(--plastic);
  }

  .core {
    --depth: calc(var(--cube) / 2 - var(--inset));
    position: absolute;
    inset: var(--inset);
    background: var(--plastic);
    backface-visibility: hidden;
  }

  .top {
    transform: rotateX(90deg) translateZ(var(--depth));
  }

  .front {
    transform: translateZ(var(--depth));
  }

  .right {
    transform: rotateY(90deg) translateZ(var(--depth));
  }

  .back {
    transform: rotateY(180deg) translateZ(var(--depth));
  }

  .left {
    transform: rotateY(-90deg) translateZ(var(--depth));
  }

  .bottom {
    transform: rotateX(-90deg) translateZ(var(--depth));
  }
  
  :global(.js) .scene[data-stage]:not([data-ready]) .cube {
    animation: appear 0s 2s both;
  }

  @keyframes appear {
    from {
      visibility: hidden;
    }
    to {
      visibility: visible;
    }
  }
</style>

<script>
  import { buildCube, makeRandom } from "../lib/cube";
  import { show, tilesOf, } from "../lib/cube-player";
  import type { Stage } from "../lib/stages";

  function visitSeed() {
    try {
      const saved = sessionStorage.getItem("cube-visit");
      if (saved) return saved;
      const fresh = String(Math.random());
      sessionStorage.setItem("cube-visit", fresh);
      return fresh;
    } catch {
      return String(Math.random());
    }
  }

  const visit = visitSeed();

  for (const scene of document.querySelectorAll<HTMLElement>(".scene[data-stage]")) {
    const size = Number(scene.dataset.size);
    const stage = scene.dataset.stage as Stage;
    const cube = buildCube(size, stage, makeRandom(scene.dataset.seed + visit));
    show(tilesOf(scene), cube);
    scene.dataset.ready = "";
  }
</script>
