---
import type { Stage } from "../lib/stages";
import { buildCube, makeRandom, readFaces, turn } from "../lib/cube";

interface Props {
  size: number;
  px?: number;
  stage?: Stage;
  seed?: string;
  view?: "above" | "below";
  moves?: string;
}

const { size, px = 28, stage = "done", seed = "cube", view = "above", moves = " " } = Astro.props;

const cube = buildCube(size, stage, makeRandom(seed));
turn(cube, moves);
const faces = readFaces(cube);
---

<span class="scene" style={`--px: ${px}px; --n: ${size}`} aria-hidden="true">
  <span class={`cube ${view}`}>
    {faces.map((face) => <span class={`core ${face.name}`} />)}
    {
      faces.map((face) => (
        <span class={`face ${face.name}`}>
          {face.stickers.map((color) => (
            <span class="sticker" style={`background-color: ${color}`} />
          ))}
        </span>
      ))
    }
  </span>
</span>

<style>
  .scene {
    position: relative;
    display: inline-block;
    width: calc(var(--px) * 1.7);
    height: calc(var(--px) * 1.7);
    flex-shrink: 0;
    pointer-events: none;
  }

  .cube {
    --cube: calc(var(--px) * 4);
    --cell: calc(var(--cube) / var(--n));
    --inset: calc(var(--cell) * 0.15);
    --plastic: #111214;
    --tilt: -35deg;
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    transform: translate(-50%, -50%) scale(0.25) rotateX(var(--tilt)) rotateY(-45deg);
  }

  .below {
    --tilt: 35deg;
  }

  .face {
    --depth: calc(var(--cube) / 2);
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: calc(var(--cell) * 0.08);
    padding: calc(var(--cell) * 0.08);
    border-radius: calc(var(--cell) * 0.4);
    background: var(--plastic);
    backface-visibility: hidden;
  }

  .face::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(0 0 0 / var(--shade));
  }

  .core {
    --depth: calc(var(--cube) / 2 - var(--inset));
    position: absolute;
    inset: var(--inset);
    background: var(--plastic);
    backface-visibility: hidden;
  }

  .top {
    --shade: 0;
    transform: rotateX(90deg) translateZ(var(--depth));
  }

  .front {
    --shade: 0.06;
    transform: translateZ(var(--depth));
  }

  .right {
    --shade: 0.18;
    transform: rotateY(90deg) translateZ(var(--depth));
  }

  .back {
    --shade: 0.18;
    transform: rotateY(180deg) translateZ(var(--depth));
  }

  .left {
    --shade: 0.06;
    transform: rotateY(-90deg) translateZ(var(--depth));
  }

  .bottom {
    --shade: 0.1;
    transform: rotateX(-90deg) translateZ(var(--depth));
  }

  .sticker {
    border-radius: calc(var(--cell) * 0.2);
  }
</style>
