---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import TagList from "../../components/TagList.astro";
import ScopeCube from "../../components/ScopeCube.astro";
import { getProjects } from "../../lib/projects";
import css from "../../styles/global.css?raw";
import { stages } from "../../lib/stages";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: undefined } }]: [];
}

const [sample] = await getProjects();

const sexy = "R U R' U'";
const turnTests = [
  { label: "R", moves: "R" },
  { label: "U", moves: "U" },
  { label: "F", moves: "F" },
  { label: "R U R' U'", moves: sexy },
  { label: "R U R' U' six times", moves: Array(6).fill(sexy).join(" ") },
];

const found = [...css.matchAll(/\[data-palette="([\w-]+)"\]/g)].map((m) => m[1]);
const palettes = ["default", ...new Set(found)];

const swatches = [
  { name: "space-950", className: "bg-space-950" },
  { name: "space-900", className: "bg-space-900" },
  { name: "space-800", className: "bg-space-800" },
  { name: "starlight", className: "bg-starlight" },
  { name: "nebula", className: "bg-nebula" },
  { name: "comet", className: "bg-comet" },
];
---

<BaseLayout title="Design Lab | Donovan Thach">
  <h1 class="text-4xl font-bold tracking-tight">Design Lab</h1>
  <p class="mt-3 text-starlight/80">
    Dev-only page for comparing design choices. It is not built into the live site.
  </p>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold">Scope cubes</h2>
    <div class="mt-6 flex flex-wrap items-center gap-6">
      {[2, 3, 4, 5].map((size) => <ScopeCube size={size} px={72} />)}
    </div>
    <h3 class="mt-8 text-lg font-semibold">Turn tests</h3>
    <div class="mt-4 flex flex-wrap items-start gap-6">
      {
        turnTests.map(({ label, moves }) => (
          <div class="flex flex-col items-center gap-1 text-xs text-starlight/70">
            <div class="flex">
              <ScopeCube size={3} px={56} moves={moves} />
              <ScopeCube size={3} px={56} moves={moves} view="below" />
            </div>
            <p>{label}</p>
          </div>
        ))
      }
    </div>
    <h3 class="mt-8 text-lg font-semibold">Turn it yourself</h3>
    <div id="playground" class="mt-4 flex flex-wrap items-center gap-6">
      <ScopeCube size={3} px={72} />
      <div class="flex max-w-sm flex-wrap gap-2">
        {
          ["R", "R'", "U", "U'", "F", "F'", "L", "D", "B", "R2", "R U R' U'"].map((moves) => (
            <button data-moves={moves} class="rounded-lg border border-space-800 px-3 py-1 font-mono text-sm hover:border-comet">
              {moves}
            </button>
          ))
        }
        <button data-reset class="rounded-lg border border-space-800 px-3 py-1 text-sm hover:border-comet">Reset</button>
      </div>
    </div>
    <h3 class="mt-8 text-lg font-semibold">Stages, from above and below</h3>
    <div class="mt-4 flex flex-wrap items-center gap-6">
      {
        stages.map(({ stage }) => (
          <div class="flex">
            <ScopeCube size={3} px={56} stage={stage} seed={stage} />
            <ScopeCube size={3} px={56} stage={stage} seed={stage} view="below" />
          </div>
        ))
      }
    </div>
  </section>

  {
    palettes.map((palette) => (
      <section
        data-palette={palette}
        class="mt-12 rounded-2xl border border-space-800 bg-space-950 p-6 text-starlight"
      >
        <h2 class="text-2xl font-semibold">Palette: {palette}</h2>

        <ul class="mt-6 grid grid-cols-3 gap-3 sm:grid-cols-6">
          {swatches.map((swatch) => (
            <li>
              <div class={`h-12 rounded-lg border border-space-800 ${swatch.className}`} />
              <p class="mt-1 text-xs text-starlight/70">{swatch.name}</p>
            </li>
          ))}
        </ul>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="#" class="rounded-lg bg-comet px-4 py-2 text-sm font-semibold text-space-950">
            Primary button
          </a>
          <a href="#" class="rounded-lg border border-space-800 px-4 py-2 text-sm font-semibold hover:border-comet">
            Secondary button
          </a>
          <a href="#" class="text-sm text-comet hover:underline">Text link</a>
        </div>

        <div class="mt-6">
          <TagList tags={["Python", "YOLO11", "Computer Vision"]} />
        </div>

        {sample && (
          <div class="mt-6">
            <ProjectCard project={sample} />
          </div>
        )}
      </section>
    ))
  }
</BaseLayout>

<script>
  import { solvedCube } from "../../lib/cube";
  import { animateTurn, show, tilesOf } from "../../lib/cube-player";

  const playground = document.querySelector("#playground")!;
  const tiles = tilesOf(playground);
  let cube = solvedCube(3);
  let queue = Promise.resolve();

  for (const button of playground.querySelectorAll<HTMLButtonElement>("[data-moves]")) {
    button.addEventListener("click", () => {
      for (const move of button.dataset.moves!.split(" ")) {
        queue = queue.then(() => animateTurn(tiles, cube, move, 300));
      }
    });
  }

  playground.querySelector("[data-reset]")!.addEventListener("click", () => {
    queue = queue.then(() => {
      cube = solvedCube(3);
      show(tiles, cube);
    });
  });
</script>
